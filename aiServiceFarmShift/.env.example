# Environment Configuration for aiServiceFarmShift
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Vision AI & OCR Engine Settings
# Options: hybrid, openai, vision_llm, rule_based
OCR_ENGINE=hybrid
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Groq STT & Chat
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Internal service-to-service shared secret (replace with a strong random token in production)
AI_INTERNAL_TOKEN=farmshift-local-ai-token

# CORS (Backend URLs)
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
