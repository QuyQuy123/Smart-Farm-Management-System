# Environment Configuration for aiServiceFarmShift
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Vision AI & OCR Engine Settings
# Options: hybrid, openai, vision_llm, rule_based
OCR_ENGINE=hybrid
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Groq STT & Chat
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# CORS (Frontend & Backend URLs)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:8080"]
