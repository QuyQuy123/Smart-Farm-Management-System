DB_HOST=your_db_host_here
STORAGE_PROVIDER=local
# Optional absolute path; leave empty to locate frontendFarmShift/public/img automatically.
STORAGE_LOCAL_DIRECTORY=
DB_PORT=5432
DB_NAME=farmshift_db
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here

JWT_SECRET=your_base64_jwt_secret_key_at_least_256_bits_here
JWT_EXPIRATION_MS=86400000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email_here@gmail.com
MAIL_PASSWORD=your_email_app_password_here

R2_ACCESS_KEY=your_r2_access_key_here
R2_SECRET_KEY=your_r2_secret_key_here
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=farmshift-storage
R2_PUBLIC_URL=https://your_public_r2_dev_url.r2.dev

RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=FarmShift <onboarding@resend.dev>

# Public seller details displayed on sales invoices
sales.invoice.seller.name=
sales.invoice.seller.tax-code=
sales.invoice.seller.address=
sales.invoice.seller.phone=
sales.invoice.seller.fax=
sales.invoice.seller.bank-account=
